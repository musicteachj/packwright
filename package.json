{
  "name": "packwright",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Packaging label compliance generator — print-accurate GS1 retail, GHS chemical, and FDA food labels, with a compliance engine that cites its sources.",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @packwright/api",
    "dev:web": "npm run dev --workspace @packwright/web",
    "build": "npm run build --workspace @packwright/web && npm run build --workspace @packwright/api",
    "start": "npm run start --workspace @packwright/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:build": "bash scripts/verify-build.sh",
    "generate:font-metrics": "node scripts/generate-font-metrics.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.10.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
