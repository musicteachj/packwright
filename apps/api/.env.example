# Copy to `.env`. `apps/api/src/server.ts` loads it before anything reads the
# environment, and `loadEnv` parses it once at startup and fails loudly if it is
# wrong — a missing database URI deferred to the first request that needs it is a
# container that reports healthy and then fails under traffic.

# Required. `docker compose up -d` serves this one.
MONGODB_URI=mongodb://localhost:27017/packwright

# Optional until phase 7. Server-side only — it must never reach the browser
# bundle, which is why vision extraction lives in `apps/api`.
ANTHROPIC_API_KEY=

# A shared secret the audit route requires, or blank to require none. Set it and
# `POST /api/audit/ghs` is shut to anything that cannot present it in an
# `X-Audit-Key` header. The key is never built into the browser client, which
# everyone who loads the page can read; the audit page asks the person using it
# to type it in. Required in production whenever ANTHROPIC_API_KEY is set: the
# server refuses to start without it.
AUDIT_API_KEY=

# Optional. How many vision calls the audit route may make in a UTC day, across
# the deployment. Blank means 10, about $1.30 a day. Keep it a small fraction of
# the Anthropic workspace's monthly spend limit. 0 turns live audits off.
AUDIT_DAILY_LIMIT=

# Optional. How many proxies sit in front of this server, as a hop count. Only
# the audit route's per-client quota reads it. Left blank behind a load balancer,
# every request looks like it came from the balancer and that quota becomes one
# bucket shared by the world — blunt, but it refuses rather than admits. Never
# set this higher than the number of proxies you actually run: a caller who can
# write `X-Forwarded-For` past them gets a fresh quota per request.
TRUST_PROXY_HOPS=
