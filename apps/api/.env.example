# Copy to `.env`. `apps/api/src/server.ts` loads it before anything reads the
# environment, and `loadEnv` parses it once at startup and fails loudly if it is
# wrong — a missing database URI deferred to the first request that needs it is a
# container that reports healthy and then fails under traffic.

# Required. `docker compose up -d` serves this one.
MONGODB_URI=mongodb://localhost:27017/packwright

# Optional until phase 7. Server-side only — it must never reach the browser
# bundle, which is why vision extraction lives in `apps/api`.
ANTHROPIC_API_KEY=
