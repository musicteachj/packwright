# Copy to `.env`. `apps/api/src/server.ts` loads it before anything reads the
# environment, and `loadEnv` parses it once at startup and fails loudly if it is
# wrong — a missing database URI deferred to the first request that needs it is a
# container that reports healthy and then fails under traffic.

# Required, and it must name its database (the path after the host): the server
# refuses a URI without one, which the driver would write to `test`. An Atlas
# string as the console gives it ends `.mongodb.net/?...`, so put the name before
# the `?`. `docker compose up -d` serves this one.
MONGODB_URI=mongodb://localhost:27017/packwright

# Optional until phase 7. Server-side only — it must never reach the browser
# bundle, which is why vision extraction lives in `apps/api`.
ANTHROPIC_API_KEY=

# The owner's path: a shared secret the audit route requires, or blank to require
# none. Set it and `POST /api/audit/ghs` is shut to anything that cannot present it
# in an `X-Audit-Key` header. Metered by the budget below and the hourly limit, not
# counted per visitor, and not the public path: the audit page has no key field, so
# a browser is told this server does not read photographs live. In production with
# ANTHROPIC_API_KEY set, this or AUDIT_PUBLIC=true is required. Never both.
AUDIT_API_KEY=

# The public path: true or false, blank means false. Live photo reads behind
# Cloudflare's Turnstile bot check, counted per visitor and metered by the budget
# below. Requires the three TURNSTILE_ settings and AUDIT_IP_HASH_KEY, and in
# production TRUST_PROXY_HOPS=1. Cannot be true while AUDIT_API_KEY is set.
AUDIT_PUBLIC=

# Required when AUDIT_PUBLIC is true. These are Cloudflare's public test values (the
# site key that always passes, and the secret that always passes), which production
# refuses unless every TURNSTILE_HOSTNAMES entry is localhost or 127.0.0.1.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Required when AUDIT_PUBLIC is true. The hostnames a passing token may come from,
# comma-separated, bare (no scheme, port or path).
TURNSTILE_HOSTNAMES=localhost

# Required when AUDIT_PUBLIC is true; at least 32 characters; generate with
# openssl rand -hex 32. It keys the hash each visitor's daily count is stored under,
# so no address is ever stored.
AUDIT_IP_HASH_KEY=

# Optional. How many live reads one visitor may make in a UTC day on the public
# path. Blank means 5; at most 1000.
AUDIT_READS_PER_IP_PER_DAY=

# The monthly AI budget, in dollars (up to six decimals, at most 1000). Every live
# photo read reserves its worst case, $0.112, against it before it is sent and
# settles at what it cost. Blank means 0 outside production: live reads off.
# Required in production whenever ANTHROPIC_API_KEY is set; 0 turns live reads off.
AI_MONTHLY_BUDGET_USD=

# Optional. How far ahead of an even pace one day may spend: today may reserve this
# many times an even share of what is left of the month. Blank means 3; 1 to 31.
AI_PACING_MULTIPLIER=

# Optional. The least any day may spend, in dollars, while the month has that much
# left. Blank means 0.5; at most 1000.
AI_DAILY_FLOOR_USD=

# Optional. How many saved labels one address may create in an hour. Blank means
# 10. The end-to-end suite raises it, since it reuses one server across runs.
LABEL_CREATES_PER_HOUR=

# Optional. Tool calls an hour that /mcp allows, shared by everything arriving
# from Anthropic's outbound ranges (claude.ai, Claude Desktop, mobile). Blank
# means 1000; 1 to 100000. A higher figure costs more CPU at worst; a lower one
# keeps one caller from using up the shared allowance as fast.
MCP_ANTHROPIC_CALLS_PER_HOUR=

# Optional. How many proxies sit in front of this server, as a hop count. Every
# per-client quota reads it: the audit's, the exports', saved-label writes' and
# /mcp's. Left blank behind a load balancer,
# every request looks like it came from the balancer and that quota becomes one
# bucket shared by the world — blunt, but it refuses rather than admits. Never
# set this higher than the number of proxies you actually run: a caller who can
# write `X-Forwarded-For` past them gets a fresh quota per request.
TRUST_PROXY_HOPS=
